DATABASE_URL="file:./dev.db"
JWT_SECRET="reemplaza-esto-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="1d"
PORT=3000
CORS_ORIGIN="http://localhost:5173"

# URL pública del frontend: se usa para armar el enlace de "recuperar contraseña".
FRONTEND_URL="http://localhost:5173"

# SMTP para enviar el correo de recuperación de contraseña. Si se dejan vacías,
# el enlace solo se imprime en la consola del backend (útil en desarrollo).
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Deportiva ATG <no-reply@tudominio.com>"

# Opcional: conexión HTTP directa a Cloudflare D1 al ejecutar Express fuera de Workers.
# En el Worker desplegado, se usa el binding DB de wrangler.toml y no se necesitan estas claves.
CLOUDFLARE_ACCOUNT_ID="4ed3cc4c6bea44e84a9e0d573445aeca"
CLOUDFLARE_DATABASE_ID="6895aa3f-93a4-4ff6-9166-8ed4e007602e"
CLOUDFLARE_D1_TOKEN=""
