generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "darwin-arm64"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                     Int              @id @default(autoincrement())
  name                   String
  email                  String           @unique
  password               String
  role                   String           @default("ADMIN")
  status                 String           @default("ACTIVE")
  resetPasswordTokenHash String?
  resetPasswordExpiresAt DateTime?
  // Bloqueo por intentos fallidos de login: se incrementa en cada intento
  // con contraseña incorrecta y se resetea al loguear bien. Al llegar al
  // máximo, se fija lockedUntil y se reinicia el contador.
  failedLoginAttempts    Int              @default(0)
  lockedUntil            DateTime?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  tournaments            UserTournament[]
  // Solo se usa cuando role = "DT": el equipo que ese DT puede inscribir.
  // Único por equipo (una sola cuenta DT por equipo).
  teamId                 Int?             @unique
  team                   Team?            @relation(fields: [teamId], references: [id])
}

model Tournament {
  id                         Int              @id @default(autoincrement())
  name                       String
  description                String?
  logo                       String?
  status                     String           @default("ACTIVE")
  // Cuándo pasó a INACTIVE por última vez (manual o por expiresAt vencido).
  // null mientras está ACTIVE. Se usa para saber si ya lleva más de 15 días
  // desactivado y el superadmin puede eliminarlo definitivamente.
  deactivatedAt              DateTime?
  expiresAt                  DateTime?
  pricePerTeam               Int?
  position                   Int              @default(0)
  mode                       String           @default("ROUND_ROBIN")
  hasThirdPlace              Boolean          @default(false)
  blueCardEnabled            Boolean          @default(true)
  awayGoalsRule              Boolean          @default(false)
  championTeamId             Int?
  runnerUpTeamId             Int?
  thirdPlaceTeamId           Int?
  championLabel              String?
  finishedAt                 DateTime?
  // Fecha límite para que los DT de los equipos de este torneo inscriban
  // jugadores. Solo restringe al rol DT; admin/superadmin no se ven
  // afectados. null = sin límite.
  playerRegistrationDeadline DateTime?
  createdAt                  DateTime         @default(now())
  updatedAt                  DateTime         @updatedAt
  admins                     UserTournament[]
  teams                      TournamentTeam[]
  matches                    Match[]
  groups                     Group[]
  ties                       KnockoutTie[]
  captions                   TableCaption[]
  announcements              Announcement[]
  views                      TournamentView[]
  likes                      TournamentLike[]
  championTeam               Team?            @relation("TournamentChampion", fields: [championTeamId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  runnerUpTeam               Team?            @relation("TournamentRunnerUp", fields: [runnerUpTeamId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  thirdPlaceTeam             Team?            @relation("TournamentThirdPlace", fields: [thirdPlaceTeamId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([status])
  @@index([position])
}

// Una fila por cada carga de la página pública del torneo (solo al montar,
// no en cada refresco del polling/SSE de la vista pública), para que el
// superadmin vea cuánta gente entra a cada torneo, por día/mes/total. Se
// guarda la IP para no contar la misma IP más de una vez cada 5 minutos
// (ver VIEWS.cooldownMinutes) — así una recarga o un refresh no infla el
// contador, solo cuenta como "ingreso" nuevo cada rato.
model TournamentView {
  id           Int        @id @default(autoincrement())
  tournamentId Int
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  // Nullable porque las filas creadas antes de este campo no tienen IP
  // guardada; eso no afecta la deduplicación (solo compara contra IPs que
  // sí están seteadas).
  ipAddress    String?
  createdAt    DateTime   @default(now())

  @@index([tournamentId, ipAddress, createdAt])
}

// Se conservan TODOS los likes históricos (nunca se borran): el contador es
// simplemente el total de filas por torneo, y el ranking del Home también
// usa los likes recientes para que un torneo nuevo pueda posicionarse.
// Una misma IP no puede dar like al mismo torneo más de una vez cada 24h
// (se valida por consulta, no con una constraint única, porque SÍ puede
// volver a dar like pasadas las 24h).
model TournamentLike {
  id           Int        @id @default(autoincrement())
  tournamentId Int
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  ipAddress    String
  createdAt    DateTime   @default(now())

  @@index([tournamentId, ipAddress, createdAt])
}

model Team {
  id                    Int              @id @default(autoincrement())
  name                  String
  logo                  String?
  status                String           @default("ACTIVE")
  paidUntil             DateTime?
  logoExpiresAt         DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  tournaments           TournamentTeam[]
  homeMatches           Match[]          @relation("HomeTeam")
  awayMatches           Match[]          @relation("AwayTeam")
  players               PlayerTeam[]
  matchEvents           MatchEvent[]
  groups                GroupTeam[]
  championTournaments   Tournament[]     @relation("TournamentChampion")
  runnerUpTournaments   Tournament[]     @relation("TournamentRunnerUp")
  thirdPlaceTournaments Tournament[]     @relation("TournamentThirdPlace")
  knockoutHomeTies      KnockoutTie[]    @relation("KnockoutHomeTeam")
  knockoutAwayTies      KnockoutTie[]    @relation("KnockoutAwayTeam")
  knockoutWinnerTies    KnockoutTie[]    @relation("KnockoutWinnerTeam")
  dt                    User?
  likes                 TeamLike[]
}

model TeamLike {
  id        Int      @id @default(autoincrement())
  teamId    Int
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  ipAddress String
  createdAt DateTime @default(now())

  @@index([teamId, ipAddress, createdAt])
}

model Player {
  id                      Int          @id @default(autoincrement())
  name                    String
  birthDate               DateTime?
  documentNumber          String?      @unique
  jerseyNumber            String?
  photo                   String?
  paidUntil               DateTime?
  showName                Boolean      @default(true)
  fixedOvr                Int?
  yellowCardFinePaidCount Int          @default(0)
  redCardFinePaidCount    Int          @default(0)
  blueCardFinePaidCount   Int          @default(0)
  status                  String       @default("ACTIVE")
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  teams                   PlayerTeam[]
  matchEvents             MatchEvent[]
  likes                   PlayerLike[]
}

model PlayerLike {
  id        Int      @id @default(autoincrement())
  playerId  Int
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  ipAddress String
  createdAt DateTime @default(now())

  @@index([playerId, ipAddress, createdAt])
}

model PlayerTeam {
  playerId     Int
  teamId       Int
  isGoalkeeper Boolean  @default(false)
  player       Player   @relation(fields: [playerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  team         Team     @relation(fields: [teamId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAt    DateTime @default(now())

  @@id([playerId, teamId])
  @@index([teamId])
}

model UserTournament {
  userId       Int
  tournamentId Int
  user         User       @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAt    DateTime   @default(now())

  @@id([userId, tournamentId])
  @@index([tournamentId])
}

model TournamentTeam {
  tournamentId Int
  teamId       Int
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  team         Team       @relation(fields: [teamId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAt    DateTime   @default(now())

  @@id([tournamentId, teamId])
  @@index([teamId])
}

model Match {
  id                  Int          @id @default(autoincrement())
  tournamentId        Int
  homeTeamId          Int
  awayTeamId          Int
  date                DateTime
  time                String
  status              String       @default("SCHEDULED")
  streamUrl           String?
  homeScore           Int?
  awayScore           Int?
  homePenaltyScore    Int?
  awayPenaltyScore    Int?
  // Cronómetro: duración de cada tiempo en minutos (se pide al iniciar el
  // partido), tiempo en curso (1 o 2), cuándo arrancó ese tiempo y cuántos
  // minutos de descuento/tiempo extra se le agregaron a ese tiempo. Todo
  // null hasta que el partido se inicia por primera vez.
  halfDurationMinutes Int?
  currentPeriod       Int?
  periodStartedAt     DateTime?
  extraMinutes        Int          @default(0)
  stage               String?
  groupId             Int?
  tieId               Int?
  leg                 Int?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  tournament          Tournament   @relation(fields: [tournamentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  homeTeam            Team         @relation("HomeTeam", fields: [homeTeamId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  awayTeam            Team         @relation("AwayTeam", fields: [awayTeamId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  group               Group?       @relation(fields: [groupId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  tie                 KnockoutTie? @relation(fields: [tieId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  events              MatchEvent[]

  @@index([tournamentId, date, time])
  @@index([status])
  @@index([groupId])
  @@index([tieId])
}

model Announcement {
  id              Int         @id @default(autoincrement())
  title           String
  imageUrl        String
  linkUrl         String?
  delaySeconds    Int         @default(0)
  durationSeconds Int         @default(8)
  status          String      @default("ACTIVE")
  expiresAt       DateTime?
  tournamentId    Int?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  tournament      Tournament? @relation(fields: [tournamentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([status, createdAt])
  @@index([tournamentId])
}

model MatchEvent {
  id        Int      @id @default(autoincrement())
  matchId   Int
  teamId    Int
  playerId  Int?
  type      String
  minute    Int?
  createdAt DateTime @default(now())
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  player    Player?  @relation(fields: [playerId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([matchId, createdAt])
  @@index([teamId, type])
}

model FloatingBubble {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  label     String
  linkUrl   String
  icon      String   @default("MessageCircle")
  logoUrl   String?
  color     String   @default("emerald")
  position  Int      @default(0)
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, position])
}

model SiteSetting {
  id         Int      @id @default(1)
  faviconUrl String?
  updatedAt  DateTime @updatedAt
}

model TableCaption {
  id           Int        @id @default(autoincrement())
  tournamentId Int
  tableKey     String
  text         String?
  expiresAt    DateTime?
  updatedAt    DateTime   @updatedAt
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([tournamentId, tableKey])
}

model Group {
  id           Int         @id @default(autoincrement())
  tournamentId Int
  name         String
  position     Int         @default(0)
  createdAt    DateTime    @default(now())
  tournament   Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  teams        GroupTeam[]
  matches      Match[]

  @@index([tournamentId])
}

model GroupTeam {
  groupId   Int
  teamId    Int
  pot       Int      @default(1)
  createdAt DateTime @default(now())
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([groupId, teamId])
  @@index([teamId])
}

model KnockoutTie {
  id           Int        @id @default(autoincrement())
  tournamentId Int
  stage        String
  slot         Int
  homeTeamId   Int?
  awayTeamId   Int?
  winnerTeamId Int?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  homeTeam     Team?      @relation("KnockoutHomeTeam", fields: [homeTeamId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  awayTeam     Team?      @relation("KnockoutAwayTeam", fields: [awayTeamId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  winnerTeam   Team?      @relation("KnockoutWinnerTeam", fields: [winnerTeamId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  matches      Match[]

  @@unique([tournamentId, stage, slot])
  @@index([tournamentId, stage])
}
