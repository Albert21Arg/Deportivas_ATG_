{
  "name": "deportiva-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "web:build": "npm --prefix ../front run build",
    "serve:tunnel": "npm run web:build && node src/server.js",
    "lint": "eslint .",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev --name init",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "d1:export": "node scripts/export-to-d1.js",
    "cloudflare:dev": "npm run web:build && wrangler dev --config wrangler.toml",
    "cloudflare:deploy": "npm run web:build && wrangler deploy --config wrangler.toml"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "@prisma/adapter-d1": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^6.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "prisma": "^6.19.3",
    "wrangler": "^4.143.0"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true
  }
}
